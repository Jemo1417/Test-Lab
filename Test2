<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    
    <!-- PWA & iOS Meta Tags -->
    <meta name="theme-color" content="#0ea5e9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="المختبر">
    <meta name="description" content="تطبيق لإدارة محاليل المختبرات بشكل احترافي">
    
    <title>إدارة محاليل المختبر - PWA</title>
    
    <!-- تحميل خطوط جوجل (Tajawal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    
    <!-- تحميل Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- إعدادات Tailwind -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Tajawal', 'sans-serif'],
                    },
                    colors: {
                        primary: '#0ea5e9', // Sky 500
                        secondary: '#10B981', // Emerald 500
                        danger: '#EF4444', // Red 500
                        warning: '#F59E0B', // Amber 500
                    }
                }
            }
        }
    </script>
    
    <!-- تحميل أيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- تحميل مكتبة قراءة الباركود HTML5-QRCode (مع خاصية defer لتسريع التحميل) -->
    <script defer src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <style>
        body { background-color: #F3F4F6; -webkit-tap-highlight-color: transparent; }
        .modal-overlay { background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); }
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        ::-webkit-scrollbar { height: 6px; width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        #reader { width: 100%; border-radius: 0.5rem; overflow: hidden; }
        #reader video { object-fit: cover; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>

    <!-- إنشاء PWA Manifest & Service Worker ديناميكياً -->
    <script>
        (function initPWA() {
            // أيقونة التطبيق بصيغة SVG ومحولة لـ Base64
            const svgIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" fill="#0ea5e9" rx="100"/><path fill="#ffffff" d="M374.6 118.6c12.5-12.5 32.8-12.5 45.3 0s12.5 32.8 0 45.3L288 295.8V416h32c17.7 0 32 14.3 32 32s-14.3 32-32 32H192c-17.7 0-32-14.3-32-32s14.3-32 32-32h32V295.8L92.1 163.9c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l118.6 118.6V128c0-17.7 14.3-32 32-32s32 14.3 32 32v109.3l54.6-54.7z"/></svg>`;
            const base64Icon = 'data:image/svg+xml;base64,' + btoa(svgIcon);

            const manifest = {
                name: "إدارة محاليل المختبر",
                short_name: "مختبري",
                description: "تطبيق ويب تقدمي لإدارة مخزون المختبرات",
                start_url: window.location.href.split('?')[0],
                display: "standalone",
                background_color: "#F3F4F6",
                theme_color: "#0ea5e9",
                dir: "rtl",
                lang: "ar",
                icons: [
                    { src: base64Icon, sizes: "192x192 512x512", type: "image/svg+xml", purpose: "any maskable" }
                ]
            };
            
            const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/json' });
            const manifestUrl = URL.createObjectURL(manifestBlob);
            const link = document.createElement('link');
            link.rel = 'manifest';
            link.href = manifestUrl;
            document.head.appendChild(link);

            const swCode = `
                const CACHE_NAME = 'lab-app-v1';
                self.addEventListener('install', (event) => self.skipWaiting());
                self.addEventListener('activate', (event) => event.waitUntil(clients.claim()));
                self.addEventListener('fetch', (event) => {
                    event.respondWith(fetch(event.request).catch(() => caches.match(event.request)));
                });
            `;
            
            try {
                const swBlob = new Blob([swCode], { type: 'application/javascript' });
                const swUrl = URL.createObjectURL(swBlob);
                if ('serviceWorker' in navigator) {
                    navigator.serviceWorker.register(swUrl, { scope: './' })
                        .catch(err => console.log('SW Registration failed', err));
                }
            } catch (e) {
                console.warn('Blob Service Worker not supported', e);
            }
        })();
    </script>
</head>
<body class="text-gray-800 antialiased min-h-screen flex flex-col">

    <div id="loadingScreen" class="fixed inset-0 bg-white z-50 flex flex-col items-center justify-center">
        <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-primary mb-4"></div>
        <h2 class="text-xl font-bold text-gray-700">جاري الاتصال بنظام المختبر...</h2>
    </div>

    <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center gap-2 sm:gap-3">
                        <div class="bg-primary text-white p-2 rounded-lg">
                            <i class="fa-solid fa-flask-vial text-xl"></i>
                        </div>
                        <span class="font-bold text-lg sm:text-xl text-gray-900 truncate max-w-[150px] sm:max-w-none">إدارة المحاليل</span>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button id="installAppBtn" class="hidden bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium py-1.5 px-3 rounded-lg shadow-sm transition duration-150 flex items-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        <span class="hidden sm:inline">تثبيت التطبيق</span>
                    </button>
                    
                    <button id="iosInstallBtn" onclick="openIosInstallModal()" class="hidden bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium py-1.5 px-3 rounded-lg shadow-sm transition duration-150 flex items-center gap-2">
                        <i class="fa-brands fa-apple"></i>
                        <span class="hidden sm:inline">تثبيت للآيفون</span>
                    </button>
                    
                    <span class="text-xs sm:text-sm text-gray-500 bg-gray-100 px-3 py-1.5 rounded-full flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-secondary"></span>
                        متصل
                    </span>

                    <button id="logsBtnContainer" onclick="openLogsModal()" class="hidden bg-purple-100 hover:bg-purple-200 text-purple-700 text-sm font-medium py-1.5 px-3 rounded-lg shadow-sm transition duration-150 items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span class="hidden sm:inline">السجل</span>
                    </button>

                    <button id="adminToggleBtn" onclick="toggleAdminState()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-1.5 px-3 rounded-lg shadow-sm transition duration-150 flex items-center gap-2">
                        <i class="fa-solid fa-user-shield"></i>
                        <span class="hidden sm:inline" id="adminToggleText">دخول كمدير</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 mb-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="bg-blue-100 text-blue-600 p-3 rounded-full"><i class="fa-solid fa-vials text-xl"></i></div>
                <div>
                    <p class="text-xs font-medium text-gray-500 mb-1">إجمالي المحاليل</p>
                    <h3 id="statTotalProducts" class="text-2xl font-bold text-gray-900">0</h3>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="bg-orange-100 text-orange-600 p-3 rounded-full"><i class="fa-solid fa-calendar-xmark text-xl"></i></div>
                <div>
                    <p class="text-xs font-medium text-gray-500 mb-1">قاربت على الانتهاء</p>
                    <h3 id="statExpiringSoon" class="text-2xl font-bold text-gray-900">0</h3>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="bg-red-100 text-red-600 p-3 rounded-full"><i class="fa-solid fa-battery-quarter text-xl"></i></div>
                <div>
                    <p class="text-xs font-medium text-gray-500 mb-1">قاربت على النفاذ (<= 5)</p>
                    <h3 id="statLowStock" class="text-2xl font-bold text-gray-900">0</h3>
                </div>
            </div>
        </div>

        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-6 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="relative w-full sm:w-1/2 flex gap-2">
                <div class="relative w-full">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-search text-gray-400"></i>
                    </div>
                    <input type="text" id="searchInput" placeholder="بحث بالاسم، الباركود، أو التشغيلة..." 
                        class="block w-full pl-3 pr-10 py-2.5 text-sm border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                </div>
                <button onclick="openScannerModal('searchInput')" class="bg-gray-100 hover:bg-gray-200 text-gray-700 p-2.5 rounded-lg border border-gray-300 transition duration-150 flex-shrink-0" title="مسح الباركود">
                    <i class="fa-solid fa-barcode text-lg"></i>
                </button>
            </div>
            
            <button id="addBtnContainer" onclick="openProductModal()" class="w-full sm:w-auto bg-primary hover:bg-blue-600 text-white font-medium py-2.5 px-6 rounded-lg shadow-sm transition duration-150 flex items-center justify-center gap-2">
                <i class="fa-solid fa-plus"></i>
                إضافة محلول
            </button>
        </div>

        <!-- شريط تصفية الأقسام -->
        <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-100 mb-6 overflow-x-auto whitespace-nowrap hide-scrollbar">
            <div class="flex gap-2" id="departmentFilters">
                <button onclick="filterByDepartment('all')" class="dept-btn bg-primary text-white px-4 py-1.5 rounded-full text-sm font-medium transition-colors shadow-sm">الكل</button>
                <button onclick="filterByDepartment('كيمياء حيوية')" class="dept-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors">كيمياء حيوية</button>
                <button onclick="filterByDepartment('أمراض دم')" class="dept-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors">أمراض دم</button>
                <button onclick="filterByDepartment('أحياء دقيقة')" class="dept-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors">أحياء دقيقة</button>
                <button onclick="filterByDepartment('هرمونات')" class="dept-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors">هرمونات</button>
                <button onclick="filterByDepartment('أخرى')" class="dept-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors">أخرى</button>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">المحلول</th>
                            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الباركود/التشغيلة</th>
                            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الشركة</th>
                            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الصلاحية</th>
                            <th scope="col" class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">الكمية</th>
                            <th scope="col" id="actionHeader" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">إجراء</th>
                        </tr>
                    </thead>
                    <tbody id="productsTableBody" class="bg-white divide-y divide-gray-200">
                        <!-- Content goes here -->
                    </tbody>
                </table>
            </div>
            
            <div id="emptyState" class="hidden flex-col items-center justify-center py-12 text-gray-500 px-4 text-center">
                <i class="fa-solid fa-flask text-4xl mb-3 text-gray-300"></i>
                <p class="text-lg">المخزون فارغ أو لا توجد نتائج.</p>
                <p class="text-sm text-gray-400 mt-1">قم بإضافة محلول جديد للبدء أو غير كلمات البحث.</p>
            </div>
        </div>
    </main>

    <!-- نافذة الإضافة/التعديل -->
    <div id="productModal" class="fixed inset-0 z-40 hidden modal-overlay items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl mx-auto fade-in flex flex-col max-h-[90vh]">
            <div class="flex justify-between items-center border-b border-gray-200 px-5 py-4">
                <h3 id="modalTitle" class="text-lg font-bold text-gray-900">إضافة محلول جديد</h3>
                <button onclick="closeProductModal()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div class="p-5 overflow-y-auto custom-scroll">
                <form id="productForm" class="space-y-4">
                    <input type="hidden" id="productId">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">اسم المحلول <span class="text-red-500">*</span></label>
                            <input type="text" id="productName" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">الباركود <span class="text-red-500">*</span></label>
                            <div class="flex gap-2">
                                <input type="text" id="productBarcode" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                                <button type="button" onclick="openScannerModal('productBarcode')" class="bg-gray-100 border border-gray-300 text-gray-700 px-3 rounded-lg">
                                    <i class="fa-solid fa-camera"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">الشركة المصنعة <span class="text-red-500">*</span></label>
                            <input type="text" id="productManufacturer" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">القسم</label>
                            <select id="productCategory" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                                <option value="كيمياء حيوية">كيمياء حيوية (Biochemistry)</option>
                                <option value="أمراض دم">أمراض دم (Hematology)</option>
                                <option value="أحياء دقيقة">أحياء دقيقة (Microbiology)</option>
                                <option value="هرمونات">هرمونات (Hormones)</option>
                                <option value="أخرى">أخرى (Others)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">رقم التشغيلة (Lot) <span class="text-red-500">*</span></label>
                            <input type="text" id="productLotNumber" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">تاريخ الصلاحية <span class="text-red-500">*</span></label>
                            <input type="date" id="productExpiration" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                        </div>
                    </div>

                    <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 space-y-3">
                        <h4 class="text-sm font-bold text-blue-800"><i class="fa-solid fa-box-open ml-1"></i> تفاصيل الكمية والتعبئة</h4>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1" title="كم عدد الكارتلج/الاختبارات داخل العلبة الواحدة؟">العدد داخل العلبة <span class="text-red-500">*</span></label>
                                <input type="number" id="productPackageSize" min="1" value="1" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary" placeholder="مثال: 5">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">رصيد (العُلب) <span class="text-red-500">*</span></label>
                                <input type="number" id="productStockBoxes" min="0" value="0" required class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">رصيد مفرد (كارتلج)</label>
                                <input type="number" id="productStockUnits" min="0" value="0" class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-primary focus:border-primary">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="border-t border-gray-200 px-5 py-4 flex justify-end gap-3 bg-gray-50 rounded-b-xl">
                <button onclick="closeProductModal()" type="button" class="bg-white border border-gray-300 text-gray-700 py-2 px-4 rounded-lg text-sm font-medium">إلغاء</button>
                <button onclick="saveProduct()" id="saveBtn" type="button" class="bg-primary text-white py-2 px-6 rounded-lg text-sm font-medium flex items-center gap-2">
                    <i class="fa-solid fa-save"></i> حفظ
                </button>
            </div>
        </div>
    </div>

    <!-- نافذة سحب / إدخال المحاليل السريعة (الحركات) -->
    <div id="transactionModal" class="fixed inset-0 z-[55] hidden modal-overlay items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-sm mx-auto fade-in p-5 relative">
            <button onclick="closeTransactionModal()" class="absolute top-4 left-4 text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div id="txIconContainer" class="mx-auto flex items-center justify-center h-14 w-14 rounded-full mb-4">
                <i id="txIcon" class="text-2xl"></i>
            </div>
            <h3 id="txTitle" class="text-lg font-bold text-gray-900 mb-1 text-center">سحب كمية</h3>
            <p id="txProductName" class="text-sm text-gray-500 mb-5 text-center truncate">اسم المحلول</p>
            
            <input type="hidden" id="txProductId">
            <input type="hidden" id="txType">
            <input type="hidden" id="txPackageSize">
            
            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 mb-5">
                <p class="text-xs text-gray-500 mb-3 text-center">أدخل الكمية المراد <span id="txActionText">سحبها</span>:</p>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">عُلب (Boxes)</label>
                        <input type="number" id="txBoxes" min="0" value="0" class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-center text-lg font-bold focus:ring-primary focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">كارتلج (مفرد)</label>
                        <input type="number" id="txUnits" min="0" value="0" class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-center text-lg font-bold focus:ring-primary focus:border-primary">
                    </div>
                </div>
                <div id="txError" class="text-red-500 text-xs mt-3 hidden text-center font-medium bg-red-50 p-2 rounded">الكمية المطلوبة أكبر من الرصيد المتاح!</div>
            </div>
            
            <button id="confirmTxBtn" onclick="saveTransaction()" class="w-full text-white py-2.5 rounded-lg text-sm font-bold shadow-sm transition-colors">
                تأكيد العملية
            </button>
        </div>
    </div>

    <!-- باقي النوافذ -->
    <div id="scannerModal" class="fixed inset-0 z-[60] hidden modal-overlay items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-auto fade-in flex flex-col">
            <div class="flex justify-between items-center border-b border-gray-200 px-4 py-3">
                <h3 class="text-lg font-bold text-gray-900"><i class="fa-solid fa-camera ml-2 text-primary"></i> امسح الباركود</h3>
                <button onclick="closeScannerModal()" class="text-gray-400 hover:text-gray-600">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div class="p-4 flex flex-col items-center">
                <p class="text-xs text-gray-500 mb-4 text-center">وجه الكاميرا نحو باركود المحلول</p>
                <div id="reader" class="border-2 border-dashed border-gray-300 bg-black min-h-[250px] w-full relative"></div>
                <div id="scannerError" class="text-red-500 text-xs mt-3 hidden text-center font-medium bg-red-50 p-2 rounded w-full"></div>
