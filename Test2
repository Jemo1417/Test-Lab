    <div id="iosInstallModal" class="fixed inset-0 z-[70] hidden modal-overlay items-end sm:items-center justify-center p-4 pb-10">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-sm mx-auto fade-in p-6 text-center relative">
            <button onclick="closeIosInstallModal()" class="absolute top-4 left-4 text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-blue-50 mb-4 text-primary">
