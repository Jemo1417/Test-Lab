    <div id="adminAuthModal" class="fixed inset-0 z-[60] hidden modal-overlay items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-sm mx-auto fade-in p-6 text-center">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 mb-4 text-primary">
                <i class="fa-solid fa-lock text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">تسجيل دخول الإدارة</h3>
            <p class="text-sm text-gray-500 mb-4">أدخل رمز المرور للوصول إلى صلاحيات الإضافة والتعديل.</p>
            <input type="password" id="adminPassword" placeholder="أدخل رمز المرور" class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-center mb-4 focus:ring-primary focus:border-primary">
            <div id="adminAuthError" class="text-red-500 text-xs mb-3 hidden">رمز المرور غير صحيح</div>
            <div class="flex gap-3">
                <button onclick="closeAdminAuthModal()" class="flex-1 bg-gray-100 text-gray-700 py-2 rounded-lg text-sm font-medium">إلغاء</button>
                <button onclick="verifyAdmin()" class="flex-1 bg-primary text-white py-2 rounded-lg text-sm font-medium">دخول</button>
