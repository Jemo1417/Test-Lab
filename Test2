            <div class="px-4 py-3 bg-gray-50 rounded-b-xl border-t border-gray-200">
                <button onclick="closeScannerModal()" class="w-full bg-white border border-gray-300 text-gray-700 py-2 rounded-lg text-sm font-medium">إغلاق</button>
            </div>
